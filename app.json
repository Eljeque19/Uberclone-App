{
  "expo": {
    "name": "UberClone Conductor", "slug": "uberclone-driver", "version": "1.0.0", "orientation": "portrait",
    "ios": { "bundleIdentifier": "co.edu.uberclone.driver", "config": { "googleMapsApiKey": "TU_API_KEY_RESTRINGIDA" }, "infoPlist": { "NSLocationWhenInUseUsageDescription": "Para mostrar tu posición y recibir viajes cercanos." } },
    "android": { "package": "co.edu.uberclone.driver", "config": { "googleMaps": { "apiKey": "TU_API_KEY_RESTRINGIDA" } }, "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"] },
    "plugins": ["expo-location", "expo-image-picker", "expo-notifications"]
  }
}
